{
  "$schema": "https://blockstudio.dev/schema/block",
  "name": "blockstudio/pugprofile-block",
  "title": "Pug Profile",
  "category": "text",
  "icon": "star-filled",
  "description": "Pug Adoption Post Block: Profile.",
"blockstudio": {
    "attributes": [
	{
	  "id": "agenum",
	  "type": "number",
	  "label": "Age",
	  "default" : 0,
	  "fallback": 0,
	  "hideHTMLArrows": true,
	  "required": true,
	  "min": 0,
	  "max": 30,
	  "step": 0.5
	},
	{
	  "id": "ageunit",
	  "type": "radio",
	  "label": "Age Unit",
	  "options": [
		{
		  "value": "years",
		  "label": "Years"
	    },
		{
		  "value": "months",
		  "label": "Months"
	    }
	  ]
	},
	{
	  "id": "sex",
	  "type": "radio",
	  "label": "Sex",
	  "options": [
		  {
		    "value": "M",
		    "label": "Male"
		  },
		  {
		    "value": "F",
		    "label": "Female"
		  }
	  ]
	},
	{
	  "id": "weight",
	  "type": "number",
	  "label": "Weight",
	  "default": 0,
	  "fallback": 0,
	  "hideHTMLArrows": true,
	  "required": true,
	  "min": 0,
	  "max": 40,
	  "step": 0.1
	},
	{
	  "id": "altered",
	  "type": "radio",
	  "label": "Altered",
	  "options": [
	    {
		  "value": "Yes",
		  "label": "Yes"
	    },
	    {
		  "value": "No",
		  "label": "No"
	    }
	  ]
	},
	{
	  "id": "prevlife",
	  "type": "select",
	  "label": "Previous Life",
	  "default": "Owner Surrender",
	  "options": [
		{
		  "value": "Owner Surrender",
		  "label": "Owner Surrender"
		},
		{
		  "value": "Breeder Release",
		  "label": "Breeder Release"
		},
		{
		  "value": "Owner Deceased",
		  "label": "Owner Deceased"
		},
		{
		  "value": "Stray",
		  "label": "Stray"
		},
		{
		  "value": "Unknown",
		  "label": "Unknown"
		}
	  ],
	  "multiple": false
	},
	{
	  "id": "gwd",
	  "type": "radio",
	  "label": "Good With Dogs",
	  "options": [
		{
		  "value": "Yes",
		  "label": "Yes"
		},
		{
		  "value": "No",
		  "label": "No"
		},
		{
		  "value": "Unknown",
		  "label": "Unknown"
		}
	  ]
	},
	{
	  "id": "gwc",
	  "type": "radio",
	  "label": "Good With Cats",
	  "options": [
		{
		  "value": "Yes",
		  "label": "Yes"
		},
		{
		  "value": "No",
		  "label": "No"
		},
		{
		  "value": "Unknown",
		  "label": "Unknown"
		}
	  ]
	},
	{
	  "id": "gwk",
	  "type": "radio",
	  "label": "Good With Children",
	  "options": [
		{
		  "value": "Yes",
		  "label": "Yes"
		},
		{
		  "value": "No",
		  "label": "No"
		},
		{
		  "value": "Unknown",
		  "label": "Unknown"
		}
	  ]
	},
	{
	  "id": "likes",
	  "type": "textarea",
	  "label": "Likes",
	  "min": 0,
	  "max": 600,
	  "rows": 4
	},
	{
	  "id": "dislikes",
	  "type": "textarea",
	  "label": "Dislikes",
	  "min": 0,
	  "max": 600,
	  "rows": 4
	},
	{
	  "id": "htrain",
	  "type": "radio",
	  "label": "House Trained",
	  "options": [
		{
		  "value": "Yes",
		  "label": "Yes"
		},
		{
		  "value": "No",
		  "label": "No"
		},
		{
		  "value": "Unknown",
		  "label": "Unknown"
		}
	  ]
	},
	{
	  "id": "ctrain",
	  "type": "radio",
	  "label": "Crate Trained",
	  "options": [
		{
		  "value": "Yes",
		  "label": "Yes"
		},
		{
		  "value": "No",
		  "label": "No"
		},
		{
		  "value": "Unknown",
		  "label": "Unknown"
		}
	  ]
	},
	{
	  "id": "fyr",
	  "type": "radio",
	  "label": "Fenced Yard Required",
	  "options": [
		{
		  "value": "Yes",
		  "label": "Yes"
		},
		{
		  "value": "No",
		  "label": "No"
		},
		{
		  "value": "No, but preferred",
		  "label": "No, but preferred"
		}
	  ]
	},
	{
	  "id": "specneeds",
	  "type": "textarea",
	  "label": "Special Needs",
	  "min": 0,
	  "max": 1400,
	  "rows": 6
	}
  ]
}
}
